rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.aiAnalysisStatus in ['completed', 'partial', 'failed']
        && request.resource.data.photoCount is int
        && request.resource.data.photoCount >= 1
        && request.resource.data.photoCount <= 5
        && request.resource.data.photoIds is list
        && request.resource.data.photoIds.size() == request.resource.data.photoCount
        && request.resource.data.keys().hasOnly([
          'title', 'detail', 'category', 'location', 'locationId', 'latitude', 'longitude',
          'status', 'aiAnalysisStatus', 'aiSuggestions', 'photoCount', 'photoIds',
          'submittedBy', 'createdAt', 'reviewedAt', 'reviewedBy', 'reviewNote'
        ]);

      allow get, list: if signedIn()
        && (isAdmin() || resource.data.submittedBy == request.auth.uid);

      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedAt', 'reviewNote'
        ]);
      allow delete: if false;

      match /photos/{photoId} {
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.submittedBy == request.auth.uid
          && request.resource.data.submittedBy == request.auth.uid
          && request.resource.data.photoBytes is bytes
          && request.resource.data.photoBytes.size() <= 716800
          && request.resource.data.contentType in ['image/jpeg', 'image/png', 'image/webp']
          && request.resource.data.keys().hasOnly([
            'photoBytes', 'contentType', 'detections', 'image', 'photoIndex', 'submittedBy'
          ]);
        allow get, list: if signedIn()
          && (isAdmin() || resource.data.submittedBy == request.auth.uid);
        allow update, delete: if false;
      }
    }
  }
}
